# Supabase (público — browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App (origem pública — auth, convites, billing)
# Produção: https://pet-gestor-sepia.vercel.app (sem barra final)
# Dev local: http://localhost:3000 (ou deixe vazio)
NEXT_PUBLIC_APP_URL=
APP_URL=

# Mercado Pago (SERVER-ONLY — nunca prefixar com NEXT_PUBLIC_)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=test
MERCADO_PAGO_TEST_PAYER_EMAIL=

# Supabase service role (SERVER-ONLY — webhook/billing)
SUPABASE_SERVICE_ROLE_KEY=

# Dev opcional
BILLING_DEV_BYPASS=false

# WhatsApp Cloud API (SERVER-ONLY — nunca prefixar com NEXT_PUBLIC_)
# Cole os valores só no .env.local ou na Vercel. Nunca no chat.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=
WHATSAPP_SEND_ENABLED=false
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TEMPLATE_CUSTOMER_SAME_DAY=
WHATSAPP_TEMPLATE_CUSTOMER_2H=
WHATSAPP_TEMPLATE_PET_READY=
WHATSAPP_TEMPLATE_EMPLOYEE_SAME_DAY=
WHATSAPP_TEMPLATE_EMPLOYEE_2H=
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_CUSTOMER_24H=
WHATSAPP_TEST_RECIPIENT=
CRON_SECRET=
